DB_HOST=localhost
DB_PORT=5432
DB_NAME=facturador
DB_USERNAME=postgres
DB_PASSWORD=your_password
DB_SCHEMA=app
DB_POOL_MAX=30

JWT_SECRET=change-this-secret
JWT_EXPIRES_IN=8h

AWS_ACCESS_KEY=your_aws_access_key
AWS_SECRET_KEY=your_aws_secret_key
AWS_BUCKET=your_bucket_name
AWS_REGION=us-east-1
AWS_URL_FILE=https://your_bucket.s3.amazonaws.com/

CERT_ENCRYPTION_KEY=your_64_char_hex_encryption_key

REDIS_HOST=localhost
REDIS_PORT=6379

PORT=3000
BULLMQ_CONCURRENCY=5

FRONTEND_URL=http://localhost:8080

SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@example.com
SMTP_PASS=your_smtp_password
SMTP_FROM=App <info@example.com>

# ── Cobro con PagoPlux (pago único) ──
# Sin PAGOPLUX_HABILITADO=true el panel ofrece contactar por WhatsApp en vez de pagar en línea.
PAGOPLUX_HABILITADO=false
# sandbox | prod (define el script del botón, la IP del hook y el correo del establecimiento)
PAGOPLUX_AMBIENTE=sandbox
# mila: AutorizadorEC usa el establecimiento de Mila; Mila recibe el hook de Plux y nos reenvía
#       los avisos «autorizadorec|…» firmados con HMAC-SHA256 (X-Mila-Firma).
#       En Mila: PAGOPLUX_REENVIOS=autorizadorec=https://api.autorizadorec.com/api/v1/pagos/plux/aviso
#       y el MISMO PAGOPLUX_REENVIO_SECRETO en las dos APIs (64 caracteres hex, nunca las credenciales de Plux).
# plux: establecimiento propio; el hook de Plux apunta directo a /api/v1/pagos/plux/aviso.
PAGOPLUX_AVISOS=mila
PAGOPLUX_REENVIO_SECRETO=
# Solo con PAGOPLUX_AVISOS=plux: credenciales del establecimiento (Developers › Clave de API's)
PAGOPLUX_CLIENT_ID=
PAGOPLUX_SECRET=
# Opcionales: PAGOPLUX_EMAIL, PAGOPLUX_NOMBRE (VEYZASOFT), PAGOPLUX_SCRIPT_URL, PAGOPLUX_HOOK_IPS (off solo en pruebas)
# Destinatarios de las alertas de pagos y de los bloqueos automáticos (por defecto salazarmanuel6@gmail.com)
COLLECTIONS_REPORT_TO=
